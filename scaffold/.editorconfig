root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# YAML forbids tabs.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

[{compose,docker-compose}.{yml,yaml}]
indent_style = space
indent_size = 4

# Written by composer and npm, which indent with spaces.
[*.json]
indent_style = space
indent_size = 4

[package.json]
indent_size = 2
